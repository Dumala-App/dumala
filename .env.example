# Dumala local environment template
#
# Leave blank for local dev auto-enable once the Supabase URL and publishable key are filled.
# Use false to force local-only mode. Use true to force cloud mode in deployed environments.
VITE_DUMALA_CLOUD_ENABLED=

# Supabase local defaults from `supabase start`.
# Use the local anon/publishable key here. Never put service-role, secret, or database credentials
# in Vite variables because they are bundled into the browser application.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional local Google OAuth provider values for Supabase Auth.
# These are read by `supabase/config.toml` during local Supabase development only.
# Do not prefix OAuth secrets with VITE_ because Vite variables are bundled into the browser.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
