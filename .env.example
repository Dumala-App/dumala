# Dumala local environment template
#
# Leave blank for local dev auto-enable once the Supabase URL and publishable key are filled.
# Use false to force local-only mode. Use true to force cloud mode in deployed environments.
VITE_DUMALA_CLOUD_ENABLED=

# Supabase local defaults from `supabase start`.
# Use the local anon/publishable key here. Never put service-role, secret, or database credentials
# in Vite variables because they are bundled into the browser application.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Phase 6 persona apps (Player and League Owner). Leave blank/false to keep the
# Coach app the only surface. Set to true to open the new doors. The public League
# request form also opens automatically when the League app is enabled.
VITE_DUMALA_PLAYER_APP_ENABLED=
VITE_DUMALA_LEAGUE_APP_ENABLED=
VITE_DUMALA_LEAGUE_REQUEST_ENABLED=

# Player/League app preview mode. Set to true to open #/player (or #/league)
# straight into a demo dashboard with NO login and NO cloud (in-memory sample
# data) so the UI can be reviewed without an account. Leave blank/false to
# restore the sign-in gate. For preview only — never enable in production.
VITE_DUMALA_PLAYER_PREVIEW=
VITE_DUMALA_LEAGUE_PREVIEW=

# Team Chat (shared Coach/Player team channel). Off by default.
VITE_DUMALA_CHAT_ENABLED=

# Optional local Google OAuth provider values for Supabase Auth.
# These are read by `supabase/config.toml` during local Supabase development only.
# Do not prefix OAuth secrets with VITE_ because Vite variables are bundled into the browser.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
