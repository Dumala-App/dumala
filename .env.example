# Dumala local environment
#
# Cloud sync is disabled unless this flag is explicitly true.
VITE_DUMALA_CLOUD_ENABLED=false

# Supabase local defaults from `supabase start`.
# Replace these with staging/production values only in environment-specific secret stores.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
